# Dolibarr Configuration (Docker için)
DOLIBARR_BASE_URL=http://localhost:8080
DOLIBARR_API_KEY=your-api-key-here
DOLIBARR_API_PREFIX=/api/index.php
DOLIBARR_TIMEOUT=30000
DOLIBARR_ENABLE_CACHE=true

# Application Configuration
APP_PORT=3001
APP_URL=http://localhost:3001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database (optional - for app-specific data)
DATABASE_URL=postgresql://user:password@localhost:5432/dolibarr_panel

# Session Configuration
SESSION_SECRET=your-session-secret-here
SESSION_MAX_AGE=86400000

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log