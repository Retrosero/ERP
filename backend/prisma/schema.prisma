enum OvertimeType {
  WEEKDAY
  WEEKEND
  HOLIDAY
  NIGHT
  COMPENSATORY
}

enum OvertimeRecordStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  PAID
