// ============================================
// ATTENDANCE SUMMARY / ÖZET RAPOR
// ============================================

model AttendanceSummary {
  id              String   @id @default(uuid())
  firm_id         String

  user_id         String
  dolibarr_user_id Int?

  // Dönem
  period_start    DateTime @db.Date
  period_end      DateTime @db.Date

  // Çalışma günleri
  working_days    Int      // Toplam çalışma günü
  present_days    Int      // Geldiği gün
  absent_days     Int      // Gelmediği gün
  late_days       Int      // Geç kaldığı gün

  // Saatler
  total_work_hours     Decimal @db.Decimal(7, 2) // Toplam çalışma saati
  total_overtime_hours Decimal @db.Decimal(7, 2) // Toplam fazla mesai
  total_late_hours     Decimal @db.Decimal(5, 2) // Toplam geç kalma

  // İzinler
  leave_days      Int      @default(0)
  sick_days       Int      @default(0)

  // Verimlilik (%)
  productivity_rate Decimal @db.Decimal(5, 2)

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  firm            Firm     @relation(fields: [firm_id], references: [id], onDelete: Cascade)

  @@unique([firm_id, user_id, period_start, period_end])
  @@index([firm_id])
  @@index([user_id])
  @@index([period_start])
  @@map("attendance_summaries")
}

// ============================================
// SALARY DEFINITION / MAAŞ TANIMI
// ============================================

model SalaryDefinition {
  id                String   @id @default(uuid())
  firm_id           String

  user_id           String

  // Temel Maaş
  base_salary       Decimal  @db.Decimal(12, 2)
  currency          String   @default("TRY")

  // Saat Hesaplama
  hourly_rate       Decimal? @db.Decimal(10, 2)
  daily_rate        Decimal? @db.Decimal(10, 2)

  // Ek Ödemeler
  meal_allowance    Decimal  @default(0) @db.Decimal(10, 2)
  transport_allowance Decimal @default(0) @db.Decimal(10, 2)
  housing_allowance Decimal  @default(0) @db.Decimal(10, 2)
  other_allowances  Decimal  @default(0) @db.Decimal(10, 2)

  // Kesintiler (varsayılan oranlar)
  sgk_rate          Decimal  @default(0.14) @db.Decimal(5, 4)
  unemployment_rate Decimal  @default(0.01) @db.Decimal(5, 4)
  stamp_duty_rate   Decimal  @default(0.00759) @db.Decimal(6, 5)

  // Mesai Çarpanları
  overtime_rate     Decimal  @default(1.5) @db.Decimal(3, 2)
  weekend_rate      Decimal  @default(2.0) @db.Decimal(3, 2)
  holiday_rate      Decimal  @default(2.0) @db.Decimal(3, 2)

  // Yasal Bilgiler
  insurance_number  String?
  insurance_type    String?
  tax_id            String?

  // Çalışma Bilgileri
  work_hours_per_month Int   @default(225)

  // Geçerlilik
  effective_date    DateTime @default(now())
  end_date          DateTime?

  is_active         Boolean  @default(true)

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  firm              Firm     @relation(fields: [firm_id], references: [id], onDelete: Cascade)

  @@unique([firm_id, user_id, effective_date])
  @@index([firm_id])
  @@index([user_id])
  @@map("salary_definitions")
}

// ============================================
// PAYROLL / BORDRO
// ============================================

model Payroll {
  id                String   @id @default(uuid())
  firm_id           String
  user_id           String

  // Dönem Bilgisi
  period_year       Int
  period_month      Int
  period_start      DateTime
  period_end        DateTime

  // Çalışma Bilgileri
  working_days      Int
  actual_days       Int
  overtime_hours    Decimal  @default(0) @db.Decimal(6, 2)
  weekend_hours     Decimal  @default(0) @db.Decimal(6, 2)
  holiday_hours     Decimal  @default(0) @db.Decimal(6, 2)
  absence_days      Int      @default(0)
  late_days         Int      @default(0)

  // Brüt Maaş
  base_salary       Decimal  @db.Decimal(12, 2)
  daily_rate        Decimal  @db.Decimal(10, 2)

  // Eklentiler
  meal_allowance    Decimal  @default(0) @db.Decimal(10, 2)
  transport_allowance Decimal @default(0) @db.Decimal(10, 2)
  housing_allowance Decimal  @default(0) @db.Decimal(10, 2)
  overtime_pay      Decimal  @default(0) @db.Decimal(10, 2)
  weekend_pay       Decimal  @default(0) @db.Decimal(10, 2)
  holiday_pay       Decimal  @default(0) @db.Decimal(10, 2)
  other_earnings    Decimal  @default(0) @db.Decimal(10, 2)

  gross_salary      Decimal  @db.Decimal(12, 2)

  // Yasal Kesintiler
  sgk_employee      Decimal  @default(0) @db.Decimal(10, 2)
  unemployment_employee Decimal @default(0) @db.Decimal(10, 2)
  income_tax        Decimal  @default(0) @db.Decimal(10, 2)
  stamp_duty        Decimal  @default(0) @db.Decimal(10, 2)
  agi_deduction     Decimal  @default(0) @db.Decimal(10, 2)
  other_deductions  Decimal  @default(0) @db.Decimal(10, 2)

  total_deductions  Decimal  @db.Decimal(10, 2)

  // Net Maaş
  net_salary        Decimal  @db.Decimal(12, 2)

  // İşveren Maliyeti
  sgk_employer     Decimal  @default(0) @db.Decimal(10, 2)
  unemployment_employer Decimal @default(0) @db.Decimal(10, 2)
  total_cost       Decimal  @db.Decimal(12, 2)

  // Avans ve Zimmet Kesintisi
  advance_deduction Decimal  @default(0) @db.Decimal(10, 2)
  equipment_deduction Decimal @default(0) @db.Decimal(10, 2)

  // Ödeme
  payment_date      DateTime?
  payment_method    String?
  payment_reference String?
  bank_account      String?

  // Durum
  status            PayrollStatus @default(DRAFT)

  // Onay
  approved_by       String?
  approved_at       DateTime?

  // Notlar
  notes             String?

  // Dolibarr
  dolibarr_payroll_id Int?

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  firm              Firm     @relation(fields: [firm_id], references: [id], onDelete: Cascade)

  @@unique([firm_id, user_id, period_year, period_month])
  @@index([firm_id])
  @@index([user_id])
  @@index([period_year, period_month])
  @@index([status])
  @@map("payrolls")
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

// ============================================
// OVERTIME RECORD / FAZLA MESAİ
// ============================================

model OvertimeRecord {
  id                String   @id @default(uuid())
  firm_id           String
  user_id           String

  period_year       Int
  period_month      Int

  type              OvertimeType

  date              DateTime @db.Date
  start_time        String
  end_time          String

  hours             Decimal  @db.Decimal(4, 2)
